{:deps {:aliases [:cljs]}
 :dev-http {8088 "public"}
 :builds
 {:app
  {:target     :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules    {:main {:init-fn golova.app/init}}
   :compiler-options {:infer-externs :auto
                      :warnings-as-errors false
                      :warnings {:fn-deprecated false
                                 :protocol-multiple-impls false}}}
  :test
  {:target    :node-test
   :output-to "out/test.js"
   :ns-regexp ".*-test$"
   :compiler-options {:warnings-as-errors false
                      :warnings {:fn-deprecated false
                                 :protocol-multiple-impls false}}}}}
