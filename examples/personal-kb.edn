;; Golova example knowledge base — Datahike edition.
;;
;; Three domains, each chosen to exercise a different style of PKM use:
;;
;;   people — small extended family. Shows transitive rules (ancestor),
;;            join rules (cousin, in-law, fellow-resident, coworker),
;;            declared types driving form dropdowns.
;;
;;   books  — a reading log. Shows scalar attributes (rating, status),
;;            ref relations (in-genre, recommended-by), rules that
;;            promote books from data ("priority-to-read").
;;
;;   tasks  — projects with dependencies. Shows transitive blocking
;;            (depends-on → blocks), critical-path-style derivation.
;;
;; Import via Settings → Import. This REPLACES your existing data.
;;
;; Notes on format:
;;   - Each domain's :rules is a vector of Datalog rule clauses, EDN.
;;   - :events is the assert/retract log; we ship the facts here directly
;;     so import is one round-trip.
;;   - :schema is purely UI metadata (types drive dropdowns; predicates
;;     get auto-installed into the Datahike schema on rebuild).

{:current-domain :people
 :selection {:kind :rules}
 :theme :light
 :expanded #{:people :books :tasks}
 :domains
 {;; =====================================================================
  ;; PEOPLE
  ;; =====================================================================
  :people
  {:id :people
   :label "People"
   :imports []
   :rules
   [;; ancestor is the transitive closure of parent
    [(ancestor ?a ?d) [?a :parent ?d]]
    [(ancestor ?a ?d) [?a :parent ?p] (ancestor ?p ?d)]
    ;; descendant is ancestor flipped
    [(descendant ?d ?a) (ancestor ?a ?d)]
    ;; cousin: ?x and ?y are cousins if their respective parents are siblings.
    ;; (In our convention [:zeke :parent :alice] means "zeke is parent of alice".)
    [(cousin ?x ?y) [?p1 :parent ?x] [?p2 :parent ?y] [?p1 :sibling ?p2]]
    ;; fellow-resident: same city
    [(fellow-resident ?x ?y) [?x :lives-in ?c] [?y :lives-in ?c]]
    ;; coworker: same employer
    [(coworker ?x ?y) [?x :works-at ?e] [?y :works-at ?e]]
    ;; in-law: your spouse's ancestor is your in-law
    [(in-law ?x ?y) [?x :spouse ?s] (ancestor ?y ?s)]]
   :events
   [;; --- parents (alice has zeke+zoe as her parents, bob and carol as kids; etc.)
    {:op :assert :source "seed" :triple [:zeke :parent :alice]}
    {:op :assert :source "seed" :triple [:zoe :parent :alice]}
    {:op :assert :source "seed" :triple [:alice :parent :bob]}
    {:op :assert :source "seed" :triple [:alice :parent :carol]}
    {:op :assert :source "seed" :triple [:bob :parent :dave]}
    {:op :assert :source "seed" :triple [:bob :parent :eve]}
    {:op :assert :source "seed" :triple [:carol :parent :frank]}
    {:op :assert :source "seed" :triple [:carol :parent :grace]}
    ;; --- spouses (both directions for symmetry)
    {:op :assert :source "seed" :triple [:zeke :spouse :zoe]}
    {:op :assert :source "seed" :triple [:zoe :spouse :zeke]}
    {:op :assert :source "seed" :triple [:alice :spouse :hank]}
    {:op :assert :source "seed" :triple [:hank :spouse :alice]}
    {:op :assert :source "seed" :triple [:bob :spouse :ingrid]}
    {:op :assert :source "seed" :triple [:ingrid :spouse :bob]}
    {:op :assert :source "seed" :triple [:carol :spouse :jerry]}
    {:op :assert :source "seed" :triple [:jerry :spouse :carol]}
    ;; --- siblings (both directions; assertions not derived)
    {:op :assert :source "seed" :triple [:bob :sibling :carol]}
    {:op :assert :source "seed" :triple [:carol :sibling :bob]}
    {:op :assert :source "seed" :triple [:dave :sibling :eve]}
    {:op :assert :source "seed" :triple [:eve :sibling :dave]}
    {:op :assert :source "seed" :triple [:frank :sibling :grace]}
    {:op :assert :source "seed" :triple [:grace :sibling :frank]}
    ;; --- where they live
    {:op :assert :source "seed" :triple [:zeke :lives-in :london]}
    {:op :assert :source "seed" :triple [:zoe :lives-in :london]}
    {:op :assert :source "seed" :triple [:alice :lives-in :london]}
    {:op :assert :source "seed" :triple [:hank :lives-in :london]}
    {:op :assert :source "seed" :triple [:grace :lives-in :london]}
    {:op :assert :source "seed" :triple [:bob :lives-in :sf]}
    {:op :assert :source "seed" :triple [:dave :lives-in :sf]}
    {:op :assert :source "seed" :triple [:ingrid :lives-in :sf]}
    {:op :assert :source "seed" :triple [:carol :lives-in :nyc]}
    {:op :assert :source "seed" :triple [:frank :lives-in :nyc]}
    {:op :assert :source "seed" :triple [:jerry :lives-in :nyc]}
    {:op :assert :source "seed" :triple [:eve :lives-in :berlin]}
    ;; --- where they work
    {:op :assert :source "seed" :triple [:bob :works-at :stripe]}
    {:op :assert :source "seed" :triple [:ingrid :works-at :stripe]}
    {:op :assert :source "seed" :triple [:carol :works-at :notion]}
    {:op :assert :source "seed" :triple [:dave :works-at :openai]}
    {:op :assert :source "seed" :triple [:eve :works-at :anthropic]}
    {:op :assert :source "seed" :triple [:frank :works-at :github]}
    {:op :assert :source "seed" :triple [:jerry :works-at :github]}
    ;; --- ages
    {:op :assert :source "seed" :triple [:zeke :age 92]}
    {:op :assert :source "seed" :triple [:zoe :age 90]}
    {:op :assert :source "seed" :triple [:alice :age 70]}
    {:op :assert :source "seed" :triple [:hank :age 72]}
    {:op :assert :source "seed" :triple [:bob :age 45]}
    {:op :assert :source "seed" :triple [:ingrid :age 44]}
    {:op :assert :source "seed" :triple [:carol :age 47]}
    {:op :assert :source "seed" :triple [:jerry :age 49]}
    {:op :assert :source "seed" :triple [:dave :age 18]}
    {:op :assert :source "seed" :triple [:eve :age 21]}
    {:op :assert :source "seed" :triple [:frank :age 22]}
    {:op :assert :source "seed" :triple [:grace :age 19]}]
   :schema
   {:types
    [{:name "person"
      :constructors ["zeke" "zoe" "alice" "hank" "bob" "ingrid"
                     "carol" "jerry" "dave" "eve" "frank" "grace"]}
     {:name "city"
      :constructors ["sf" "nyc" "london" "berlin" "tokyo" "paris" "lisbon"]}
     {:name "company"
      :constructors ["stripe" "notion" "openai" "anthropic" "github" "linear"]}]
    :predicates
    [{:name "parent"   :argTypes ["person" "person"]}
     {:name "spouse"   :argTypes ["person" "person"]}
     {:name "sibling"  :argTypes ["person" "person"]}
     {:name "lives-in" :argTypes ["person" "city"]}
     {:name "works-at" :argTypes ["person" "company"]}
     {:name "age"      :argTypes ["person" "int"]}]
    :queries
    [{:name "dave's ancestors"     :text "(ancestor ?a :dave)"}
     {:name "alice's descendants"  :text "(ancestor :alice ?d)"}
     {:name "everyone in sf"       :text "[?p :lives-in :sf]"}
     {:name "dave's cousins"       :text "(cousin :dave ?c)"}
     {:name "anthropic employees"  :text "[?p :works-at :anthropic]"}
     {:name "hank's in-laws"       :text "(in-law :hank ?y)"}
     {:name "london residents"     :text "[?p :lives-in :london]"}]}}

  ;; =====================================================================
  ;; BOOKS
  ;; =====================================================================
  :books
  {:id :books
   :label "Books"
   :imports []
   :rules
   [;; A book is a 'priority to read' if it is on the wishlist AND
    ;; in a genre I have a 5-star book in.
    [(priority-to-read ?b)
     [?b :status :wishlist]
     [?b :in-genre ?g]
     [?other :rating 5]
     [?other :in-genre ?g]]
    ;; A book I haven't read yet but a friend recommended.
    [(to-read-from-friend ?b ?r)
     [?b :status :wishlist]
     [?b :recommended-by ?r]]
    ;; An author who wrote at least one of my 5-star reads.
    [(favorite-author ?a)
     [?b :rating 5]
     [?b :by ?a]]]
   :events
   [;; authors
    {:op :assert :source "seed" :triple [:dune :by :frank-herbert]}
    {:op :assert :source "seed" :triple [:foundation :by :isaac-asimov]}
    {:op :assert :source "seed" :triple [:the-dispossessed :by :ursula-le-guin]}
    {:op :assert :source "seed" :triple [:the-left-hand-of-darkness :by :ursula-le-guin]}
    {:op :assert :source "seed" :triple [:the-fifth-season :by :n-k-jemisin]}
    {:op :assert :source "seed" :triple [:the-hobbit :by :tolkien]}
    {:op :assert :source "seed" :triple [:sapiens :by :harari]}
    {:op :assert :source "seed" :triple [:geb :by :hofstadter]}
    {:op :assert :source "seed" :triple [:annihilation :by :vandermeer]}
    {:op :assert :source "seed" :triple [:dawn :by :octavia-butler]}
    {:op :assert :source "seed" :triple [:parable-of-the-sower :by :octavia-butler]}
    {:op :assert :source "seed" :triple [:the-overstory :by :richard-powers]}
    ;; genres
    {:op :assert :source "seed" :triple [:dune :in-genre :scifi]}
    {:op :assert :source "seed" :triple [:foundation :in-genre :scifi]}
    {:op :assert :source "seed" :triple [:the-dispossessed :in-genre :scifi]}
    {:op :assert :source "seed" :triple [:the-left-hand-of-darkness :in-genre :scifi]}
    {:op :assert :source "seed" :triple [:annihilation :in-genre :scifi]}
    {:op :assert :source "seed" :triple [:dawn :in-genre :scifi]}
    {:op :assert :source "seed" :triple [:parable-of-the-sower :in-genre :scifi]}
    {:op :assert :source "seed" :triple [:the-fifth-season :in-genre :fantasy]}
    {:op :assert :source "seed" :triple [:the-hobbit :in-genre :fantasy]}
    {:op :assert :source "seed" :triple [:sapiens :in-genre :nonfiction]}
    {:op :assert :source "seed" :triple [:geb :in-genre :nonfiction]}
    {:op :assert :source "seed" :triple [:the-overstory :in-genre :fiction]}
    ;; status
    {:op :assert :source "seed" :triple [:dune :status :read]}
    {:op :assert :source "seed" :triple [:foundation :status :read]}
    {:op :assert :source "seed" :triple [:the-dispossessed :status :read]}
    {:op :assert :source "seed" :triple [:the-fifth-season :status :read]}
    {:op :assert :source "seed" :triple [:sapiens :status :read]}
    {:op :assert :source "seed" :triple [:the-hobbit :status :read]}
    {:op :assert :source "seed" :triple [:geb :status :reading]}
    {:op :assert :source "seed" :triple [:annihilation :status :wishlist]}
    {:op :assert :source "seed" :triple [:dawn :status :wishlist]}
    {:op :assert :source "seed" :triple [:the-left-hand-of-darkness :status :wishlist]}
    {:op :assert :source "seed" :triple [:parable-of-the-sower :status :wishlist]}
    {:op :assert :source "seed" :triple [:the-overstory :status :dnf]}
    ;; ratings
    {:op :assert :source "seed" :triple [:dune :rating 5]}
    {:op :assert :source "seed" :triple [:the-dispossessed :rating 5]}
    {:op :assert :source "seed" :triple [:foundation :rating 4]}
    {:op :assert :source "seed" :triple [:the-fifth-season :rating 5]}
    {:op :assert :source "seed" :triple [:sapiens :rating 4]}
    {:op :assert :source "seed" :triple [:the-hobbit :rating 5]}
    {:op :assert :source "seed" :triple [:geb :rating 5]}
    ;; recommendations
    {:op :assert :source "seed" :triple [:annihilation :recommended-by :alice]}
    {:op :assert :source "seed" :triple [:dawn :recommended-by :bob]}
    {:op :assert :source "seed" :triple [:the-left-hand-of-darkness :recommended-by :alice]}
    {:op :assert :source "seed" :triple [:parable-of-the-sower :recommended-by :alice]}]
   :schema
   {:types
    [{:name "genre"  :constructors ["scifi" "fantasy" "nonfiction" "fiction" "biography" "history"]}
     {:name "status" :constructors ["wishlist" "reading" "read" "dnf" "abandoned"]}]
    :predicates
    [{:name "in-genre"       :argTypes ["atom" "genre"]}
     {:name "status"         :argTypes ["atom" "status"]}
     {:name "rating"         :argTypes ["atom" "int"]}
     {:name "by"             :argTypes ["atom" "atom"]}
     {:name "recommended-by" :argTypes ["atom" "atom"]}]
    :queries
    [{:name "wishlist"
      :text "[?b :status :wishlist]"}
     {:name "loved (5-star)"
      :text "[?b :rating 5]"}
     {:name "priority to read"
      :text "[?b :priority-to-read true]"}
     {:name "alice's recommendations"
      :text "[?b :recommended-by :alice]"}
     {:name "books by ursula"
      :text "[?b :by :ursula-le-guin]"}
     {:name "sci-fi I haven't read"
      :text "[?b :status :wishlist] [?b :in-genre :scifi]"}
     {:name "favorite authors"
      :text "[?a :favorite-author true]"}]}}

  ;; =====================================================================
  ;; TASKS
  ;; =====================================================================
  :tasks
  {:id :tasks
   :label "Tasks"
   :imports []
   :rules
   [;; X blocks Y if Y depends on X (transitive)
    [(blocks ?x ?y) [?y :depends-on ?x]]
    [(blocks ?x ?z) (blocks ?x ?y) (blocks ?y ?z)]
    ;; Critical: anything blocking a project due in 14 days
    [(critical ?b) (blocks ?b ?p) [?p :due-in 14]]
    ;; What's alice transitively blocked on
    [(alice-blocked-by ?b) [?p :owner :alice] (blocks ?b ?p)]]
   :events
   [{:op :assert :source "seed" :triple [:deck :name :kb-redesign]}
    {:op :assert :source "seed" :triple [:api :name :search-endpoint]}
    {:op :assert :source "seed" :triple [:audit :name :auth-audit]}
    {:op :assert :source "seed" :triple [:docs :name :onboarding-rewrite]}
    {:op :assert :source "seed" :triple [:hire :name :hire-a-designer]}
    {:op :assert :source "seed" :triple [:deploy :name :ship-v3]}
    {:op :assert :source "seed" :triple [:spike :name :embedding-spike]}
    ;; status
    {:op :assert :source "seed" :triple [:deck :status :in-progress]}
    {:op :assert :source "seed" :triple [:api :status :in-progress]}
    {:op :assert :source "seed" :triple [:audit :status :blocked]}
    {:op :assert :source "seed" :triple [:docs :status :todo]}
    {:op :assert :source "seed" :triple [:hire :status :todo]}
    {:op :assert :source "seed" :triple [:deploy :status :todo]}
    {:op :assert :source "seed" :triple [:spike :status :todo]}
    ;; dependencies
    {:op :assert :source "seed" :triple [:deploy :depends-on :api]}
    {:op :assert :source "seed" :triple [:deploy :depends-on :audit]}
    {:op :assert :source "seed" :triple [:audit :depends-on :hire]}
    {:op :assert :source "seed" :triple [:docs :depends-on :api]}
    {:op :assert :source "seed" :triple [:api :depends-on :spike]}
    ;; owners
    {:op :assert :source "seed" :triple [:deck :owner :alice]}
    {:op :assert :source "seed" :triple [:api :owner :bob]}
    {:op :assert :source "seed" :triple [:audit :owner :carol]}
    {:op :assert :source "seed" :triple [:docs :owner :alice]}
    {:op :assert :source "seed" :triple [:hire :owner :dave]}
    {:op :assert :source "seed" :triple [:deploy :owner :bob]}
    {:op :assert :source "seed" :triple [:spike :owner :alice]}
    ;; deadlines
    {:op :assert :source "seed" :triple [:deck :due-in 7]}
    {:op :assert :source "seed" :triple [:docs :due-in 14]}
    {:op :assert :source "seed" :triple [:api :due-in 14]}
    {:op :assert :source "seed" :triple [:audit :due-in 21]}
    {:op :assert :source "seed" :triple [:hire :due-in 30]}
    {:op :assert :source "seed" :triple [:deploy :due-in 30]}
    {:op :assert :source "seed" :triple [:spike :due-in 7]}]
   :schema
   {:types
    [{:name "project"
      :constructors ["deck" "api" "audit" "docs" "hire" "deploy" "spike"]}
     {:name "task-status"
      :constructors ["todo" "in-progress" "blocked" "done"]}]
    :predicates
    [{:name "name"       :argTypes ["project" "atom"]}
     {:name "status"     :argTypes ["project" "task-status"]}
     {:name "depends-on" :argTypes ["project" "project"]}
     {:name "owner"      :argTypes ["project" "atom"]}
     {:name "due-in"     :argTypes ["project" "int"]}]
    :queries
    [{:name "what's blocked"          :text "[?p :status :blocked]"}
     {:name "alice's projects"        :text "[?p :owner :alice]"}
     {:name "what blocks deploy"      :text "(blocks ?x :deploy)"}
     {:name "critical path"           :text "[?p :critical true]"}
     {:name "alice's blockers"        :text "[?p :alice-blocked-by true]"}
     {:name "due in 14 days"          :text "[?p :due-in 14]"}]}}}}
