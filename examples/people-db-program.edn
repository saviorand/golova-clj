;; Rules + saved queries for a Notion People DB, post-conversion-plan.
;; Assumes you've run examples/people-db-cleanup.edn first, so the
;; predicates :affiliations, :city, :country, :expertise, :source,
;; :priority, :reach-out are ref-typed.
;;
;; Apply via Settings → "Import rules & queries…", or programmatically
;; via `golova.state/apply-program!`.
;;
;; :domain accepts a string (find-or-create by label) or a keyword
;; (existing domain id). All rules + queries here live under "People".

{:rules
 [;; --- pairwise relations derived from shared attributes ---------------
  {:domain "People"
   :clause [(colleague ?a ?b)
            [?a :affiliations ?o]
            [?b :affiliations ?o]]}

  {:domain "People"
   :clause [(local ?a ?b)
            [?a :city ?c]
            [?b :city ?c]]}

  {:domain "People"
   :clause [(compatriot ?a ?b)
            [?a :country ?c]
            [?b :country ?c]]}

  {:domain "People"
   :clause [(peer ?a ?b)
            [?a :expertise ?t]
            [?b :expertise ?t]]}

  ;; People I came across via the same source (event, intro, channel)
  {:domain "People"
   :clause [(met-via ?a ?b)
            [?a :source ?s]
            [?b :source ?s]]}

  ;; --- arity-1 flags -------------------------------------------------
  ;; Inner circle = top priority AND I should reach out.
  ;; Numeric priority (1 = highest); change to :high if you converted
  ;; :priority to a categorical enum.
  {:domain "People"
   :clause [(inner-circle ?p)
            [?p :priority 1]
            [?p :reach-out :yes]]}

  ;; High-value = top priority alone
  {:domain "People"
   :clause [(high-value ?p)
            [?p :priority 1]]}

  ;; Stale = I haven't replied AND haven't flagged to ping
  {:domain "People"
   :clause [(stale ?p)
            [?p :i-did-not-reply :yes]]}]

 :queries
 [;; --- direct lookups ------------------------------------------------
  {:domain "People" :name "top priority"
   :text "[?p :priority 1]"}

  {:domain "People" :name "to reach out"
   :text "[?p :reach-out :yes]"}

  {:domain "People" :name "i never replied"
   :text "[?p :i-did-not-reply :yes]"}

  ;; --- through the rules above ---------------------------------------
  {:domain "People" :name "inner circle"
   :text "(inner-circle ?p)"
   :pinned? true}

  {:domain "People" :name "all colleagues"
   :text "(colleague ?a ?b)"}

  {:domain "People" :name "same-city pairs"
   :text "(local ?a ?b)"}

  {:domain "People" :name "shared-expertise pairs"
   :text "(peer ?a ?b)"}

  ;; --- cross-domain joins (work only after the cleanup plan ran) ------
  ;; These rely on the :label fact that convert-predicate-to-refs adds.
  ;; Without the cleanup plan they return nothing — but they won't error.
  ;; Filed under People so the program is self-contained (won't spawn
  ;; empty Organizations / Places / Topics domains on its own).

  ;; People × org-label — shows the human-readable org for each affiliation
  {:domain "People" :name "people × org"
   :text "[?p :affiliations ?o] [?o :label ?org-name]"}

  ;; All :label atoms, regardless of which domain they live in
  {:domain "People" :name "all labeled atoms"
   :text "[?o :label ?name]"}]}
